#!/usr/bin/env bash
# cbde — the friendly front-end for switching toolchain versions inside CBDE.
#
# Everything here is a thin wrapper over ghcup; `ghcup tui` remains available
# for anyone who prefers it. This exists because the target audience should not
# have to learn ghcup to change GHC version, and because a couple of the
# constraints below (plustan's GHC lock, HLS's per-GHC binaries) are silent
# footguns that deserve a warning rather than a confusing failure.
set -uo pipefail

# Compatibility-matrix helpers and the active_* probes live in the shared
# library, so that the image build, this CLI and the tests agree on them.
# shellcheck source=lib/matrix.sh
. "${CBDE_LIB:-/usr/local/lib/cbde/matrix.sh}"

GHCUP_ROOT="${GHCUP_INSTALL_BASE_PREFIX:-/nix/cbde}/.ghcup"
GHCUP_BINDIR="$GHCUP_ROOT/bin"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
note() { printf '  \033[33m!\033[0m %s\n' "$*"; }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$*"; }

installed_ghcs() { ls "$GHCUP_ROOT/ghc" 2>/dev/null; }
installed_of() { # $1 = binary prefix, e.g. cabal- / haskell-language-server-wrapper-
  ls "$GHCUP_BINDIR" 2>/dev/null | sed -n "s/^$1\([0-9].*\)$/\1/p"
}

# CBDE_MOUNTS_FILE exists for the tests, which have no /nix mount to offer.
nix_is_mounted() { awk '$2 == "/nix" { found = 1 } END { exit !found }' "${CBDE_MOUNTS_FILE:-/proc/self/mounts}"; }

# plustan reads .hie files, whose format is locked to the exact GHC *patch*
# version that produced them. The plustan binary in this image is a reader for
# one specific GHC, so switching away from it breaks analysis.
warn_plustan_mismatch() {
  local want="$1" built="${CBDE_PLUSTAN_GHC:-}"
  [ -z "$built" ] && return 0
  [ "$want" = "$built" ] && return 0
  note "plustan was built against GHC $built and can only read .hie files from"
  note "that exact version — 'plustan analyze' will not work under GHC $want."
}

usage() {
  cat <<'USAGE'
cbde — manage the toolchain versions in this container

  cbde ghc [VERSION]      show, or install+switch to, a GHC version
  cbde cabal [VERSION]    show, or install+switch to, a cabal version
  cbde hls [VERSION]      install the language server (not shipped by default)
  cbde lean [TOOLCHAIN]   show, or install+switch to, a Lean toolchain
  cbde list               what is installed, and what is active
  cbde matrix             is the active toolchain the verified set of this image?
  cbde matrix list        every compatibility matrix this image knows about
  cbde matrix reset       back to the verified set (installs what is missing)
  cbde update             refresh the list of installable versions
  cbde devcontainer       write .devcontainer/devcontainer.json into this project
  cbde doctor             check this container and volume for problems
  cbde help               this text

Examples
  cbde ghc 9.6.6          # what sc-testing-tools pins (with-compiler:)
  cbde ghc                # which GHC am I using?
  cbde hls                # set up IDE support for the active GHC
  cbde lean               # which Lean toolchain is active?

Anything installed here lands in the volume mounted at /nix, so it is
downloaded once and reused by every later container. Power users: `ghcup tui`.

Switching a version moves you off the image's compatibility matrix onto a
custom one. Nothing stops you; `cbde matrix` and `cbde doctor` say so.
USAGE
}

require_volume() {
  nix_is_mounted && return 0
  bad "no volume mounted at /nix — an install here is thrown away when the container exits."
  note "Re-run with: -v cbde-data:/nix"
  return 1
}

cmd_switch() { # $1 = tool (ghc|cabal), $2 = version (may be empty)
  local tool="$1" version="${2:-}"
  if [ -z "$version" ]; then
    case "$tool" in
      ghc)   printf 'active GHC:   %s\n' "$(active_ghc || echo '(none installed)')" ;;
      cabal) printf 'active cabal: %s\n' "$(active_cabal || echo '(none installed)')" ;;
    esac
    printf 'installed:    %s\n' "$( { [ "$tool" = ghc ] && installed_ghcs || installed_of 'cabal-'; } | tr '\n' ' ')"
    printf "switch with:  cbde %s <version>\n" "$tool"
    return 0
  fi

  [ "$tool" = ghc ] && warn_plustan_mismatch "$version"

  local present=
  if [ "$tool" = ghc ]; then
    [ -d "$GHCUP_ROOT/ghc/$version" ] && present=1
  else
    [ -x "$GHCUP_BINDIR/cabal-$version" ] && present=1
  fi

  if [ -z "$present" ]; then
    require_volume || return 1
    printf 'cbde: installing %s %s (this can take a few minutes)\n' "$tool" "$version"
    ghcup_install "$tool" "$version" || return 1
  fi
  ghcup set "$tool" "$version" || return 1
  ok "$tool $version is now active"
}

cmd_hls() {
  local version="${1:-}"
  require_volume || return 1
  local ghc; ghc="$(active_ghc)"
  if [ -z "$ghc" ]; then
    bad "no active GHC — run 'cbde ghc ${CBDE_GHC:-9.6.7}' first."
    return 1
  fi
  printf 'cbde: installing HLS%s for GHC %s (~2.5 GB — one bindist covers several GHCs)\n' \
         "${version:+ $version}" "$ghc"
  # shellcheck disable=SC2086
  ghcup install hls ${version:-} --set || return 1
  if [ -x "$GHCUP_BINDIR/haskell-language-server-$ghc" ]; then
    ok "HLS $(active_hls) installed, with a server for GHC $ghc"
  else
    bad "this HLS release ships no binary for GHC $ghc."
    note "Available: $(ls "$GHCUP_BINDIR" | sed -n 's/^haskell-language-server-\([0-9][^~]*\)$/\1/p' | tr '\n' ' ')"
    note "Switch to one of those (cbde ghc <version>) for working IDE support."
  fi
}

# The image bakes ghcup's release metadata so that provisioning needs no
# network round-trip, and ghcup only refreshes it once a day. Anyone chasing a
# GHC released more recently than the image wants this.
cmd_update() {
  require_volume || return 1
  rm -f "$GHCUP_ROOT"/cache/ghcup-*.yaml
  printf 'cbde: refreshing the list of installable versions\n'
  if ghcup list -t ghc >/dev/null; then
    ok "up to date"
  else
    bad "could not reach ghcup's release metadata"
    return 1
  fi
}

# plustan has no --version flag of any kind; `plustan capabilities` is its
# machine-readable handshake and the only thing that identifies the build.
tool_version() {
  case "$1" in
    plustan)
      local schema
      schema="$(plustan capabilities 2>/dev/null | sed -n 's/.*"schemaVersion":\([0-9]*\).*/\1/p')"
      printf 'capabilities schema v%s, reads .hie from GHC %s' \
             "${schema:-?}" "${CBDE_PLUSTAN_GHC:-?}"
      ;;
    *) "$1" --version 2>&1 | head -1 ;;
  esac
}

cmd_lean() {
  local toolchain="${1:-}"
  if [ -z "$toolchain" ]; then
    if command -v elan >/dev/null 2>&1; then
      printf 'installed Lean toolchains:\n'
      elan toolchain list 2>&1 | sed 's/^/  /'
    else
      bad "elan is not in the volume yet (run any container start, or: cbde doctor)"
    fi
    printf 'switch with:  cbde lean <toolchain>   e.g. leanprover/lean4:v4.24.0\n'
    return 0
  fi
  require_volume || return 1
  if ! elan toolchain list 2>/dev/null | grep -qF "$toolchain"; then
    printf 'cbde: installing Lean toolchain %s (~2.3 GB unpacked)\n' "$toolchain"
    lean_install "$toolchain" || return 1
  fi
  elan default "$toolchain" || return 1
  ok "Lean $toolchain is now active"
  note "the prebuilt Blaster checkout at /opt/blaster was built with ${CBDE_LEAN:-the image default};"
  note "another toolchain may need 'cd /opt/blaster && lake build' again."
}

TEMPLATE="${CBDE_TEMPLATE:-/opt/cbde/devcontainer.json}"

template_version() { sed -n 's/.*"\/\/cbde-template"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -1; }

# Writes the devcontainer template into the current project. Never clobbers
# silently: an existing file needs an interactive yes or --force, and is backed
# up either way — someone may have hand-tuned mounts or extensions in there.
cmd_devcontainer() {
  local force= dest=".devcontainer/devcontainer.json"
  [ "${1:-}" = "--force" ] && force=1

  if [ ! -f "$TEMPLATE" ]; then bad "no template in this image at $TEMPLATE"; return 1; fi
  if [ ! -w . ]; then
    bad "$(pwd) is not writable — mount your project and cd into it first."
    return 1
  fi
  if ! awk '$2 == "/workspace" { f = 1 } END { exit !f }' /proc/self/mounts \
     && [ "$(pwd)" = /workspace ]; then
    note "nothing is bind-mounted here, so this file would vanish with the container."
  fi

  if [ -e "$dest" ] && [ -z "$force" ]; then
    note "$dest already exists (template $(template_version "$dest" || echo unknown),"
    note "image ships $(template_version "$TEMPLATE"))."
    if [ -t 0 ]; then
      printf '  overwrite it? [y/N] '
      read -r reply
      case "$reply" in [yY]*) ;; *) printf '  left unchanged\n'; return 0 ;; esac
    else
      bad "refusing to overwrite. Re-run with: cbde devcontainer --force"
      return 1
    fi
  fi

  mkdir -p .devcontainer
  [ -e "$dest" ] && cp "$dest" "$dest.bak" && note "previous file saved as $dest.bak"
  cp "$TEMPLATE" "$dest"
  ok "wrote $dest (template $(template_version "$dest"))"
  note "in VS Code: Ctrl+Shift+P -> Dev Containers: Reopen in Container"
}

image_matrix() { printf '%s' "${CBDE_IMAGE_VERSION:-}"; }

# One line per known matrix; the image's own is starred.
matrix_list_table() {
  local own name f
  own="$(image_matrix)"
  [ -n "$(matrix_list)" ] || { bad "no matrices in $CBDE_MATRIX_DIR"; return 1; }
  for name in $(matrix_list); do
    f="$CBDE_MATRIX_DIR/$name.env"
    printf '  %s %-8s GHC %-8s cabal %-10s Lean %-28s%s\n' \
      "$([ "$name" = "$own" ] && printf '*' || printf ' ')" "$name" \
      "$(matrix_get "$f" CBDE_GHC)" "$(matrix_get "$f" CBDE_CABAL)" \
      "$(matrix_get "$f" CBDE_LEAN | sed 's|^leanprover/lean4:||')" \
      "$([ "$name" = "$own" ] && printf '  <- this image')"
  done
  printf '\n  Each matrix ships as its own image, cbde:<name>. Newer ones than %s: cbde pull.\n' "${own:-?}"
}

# The full picture for one matrix: baked pins, then the switchable components
# with what is actually active, then the verdict.
matrix_show() {
  local f="$1" name own
  name="$(matrix_get "$f" CBDE_IMAGE_VERSION)"; own="$(image_matrix)"
  if [ "$name" = "$own" ]; then hdr "Compatibility matrix $name (this image)"
  else hdr "Compatibility matrix $name (this container is $own)"; fi
  printf '  baked into the image:\n'
  printf '    plustan %s   blaster %s   aiken %s   z3 %s   ghcup %s\n' \
    "$(matrix_get "$f" PLUSTAN_REF)" "$(matrix_get "$f" BLASTER_REF)" \
    "$(matrix_get "$f" AIKEN_VERSION)" "$(matrix_get "$f" Z3_TAG)" "$(matrix_get "$f" GHCUP_VERSION)"
  printf '  in the volume, switchable:\n'
  [ "$name" = "$own" ] || { matrix_status "$f" | awk -F'\t' '{ printf "    %-6s %s\n", $1, $2 }'; return 0; }
  matrix_status "$f" | while IFS="$(printf '\t')" read -r comp want have state; do
    case "$state" in
      ok)       ok   "$(printf '%-6s %s' "$comp" "$want")" ;;
      optional) printf '    %-6s not pinned%s\n' "$comp" "$([ "$have" != '(none)' ] && printf ' (installed: %s)' "$have")" ;;
      missing)  bad  "$(printf '%-6s pinned %s, not installed' "$comp" "$want")" ;;
      off)      note "$(printf '%-6s pinned %s, active %s' "$comp" "$want" "$have")" ;;
    esac
  done
  printf '\n'
  if matrix_status "$f" >/dev/null; then
    ok "verified: the active toolchain is exactly matrix $name"
  else
    note "custom: the active toolchain differs from matrix $name — fine if deliberate;"
    note "back to the verified set with: cbde matrix reset"
  fi
}

# Re-apply the image's own pins, installing whatever the volume lacks. Uses the
# same switch paths as the user-facing verbs, so warnings come out the same.
matrix_apply() {
  local f="$1" v rc=0
  cmd_switch ghc   "$(matrix_get "$f" CBDE_GHC)"   || rc=1
  cmd_switch cabal "$(matrix_get "$f" CBDE_CABAL)" || rc=1
  v="$(matrix_get "$f" CBDE_HLS)";  [ -z "$v" ] || cmd_hls "$v"   || rc=1
  v="$(matrix_get "$f" CBDE_LEAN)"; [ -z "$v" ] || cmd_lean "$v"  || rc=1
  matrix_show "$f"
  return "$rc"
}

cmd_matrix() {
  local sub="${1:-show}" own f
  own="$(image_matrix)"
  case "$sub" in
    list|ls) matrix_list_table ;;
    show|status)
      f="$(matrix_file "${2:-$own}")" || return $?
      matrix_show "$f" ;;
    reset)
      f="$(matrix_file "$own")" || return $?
      matrix_apply "$f" ;;
    *)
      matrix_name_ok "$sub" || { bad "unknown matrix subcommand: $sub (list | show [NAME] | reset)"; return 2; }
      f="$(matrix_file "$sub")" || return $?
      [ "$sub" != "$own" ] && {
        bad "matrix $sub ships as its own image, cbde:$sub — this container is cbde:$own."
        note "plustan, Blaster, Z3 and aiken are baked in, so only the whole image can move"
        note "between matrices. On the host:   cbde matrix $sub"
        return 2
      }
      matrix_apply "$f" ;;
  esac
}

cmd_list() {
  hdr "Haskell toolchain (in the /nix volume)"
  printf '  GHC       installed: %s\n' "$(installed_ghcs | tr '\n' ' ')"
  printf '            active:    %s\n' "$(active_ghc || echo '-')"
  printf '  cabal     installed: %s\n' "$(installed_of 'cabal-' | tr '\n' ' ')"
  printf '            active:    %s\n' "$(active_cabal || echo '-')"
  printf '  HLS       installed: %s\n' "$(installed_of 'haskell-language-server-wrapper-' | tr '\n' ' ')"
  hdr "Lean toolchain (in the /nix volume)"
  if command -v elan >/dev/null 2>&1; then
    elan toolchain list 2>&1 | sed 's/^/  /'
  else
    printf '  (not provisioned)\n'
  fi
  hdr "Tools baked into the image"
  for t in plustan stan aiken z3 nix; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  %-9s %s\n' "$t" "$(tool_version "$t")"
    else
      printf '  %-9s (unavailable)\n' "$t"
    fi
  done
  printf '\n'
}

# Emulation is invisible from inside: uname reports the architecture the image
# was built for. Two tells remain. Rosetta maps its runtime into every process
# (/proc/self/maps mentions "rosetta"); QEMU user-mode does not, but the kernel's
# /proc/cpuinfo is not emulated, so an ARM cpuinfo under an x86_64 uname means
# some emulator is in the way. The launcher also passes the host's uname.
emulator() {
  if grep -qi rosetta /proc/self/maps 2>/dev/null; then
    printf 'rosetta'
  elif grep -q '^CPU implementer' /proc/cpuinfo 2>/dev/null \
       || case "${CBDE_HOST_ARCH:-}" in arm64|aarch64) true ;; *) false ;; esac; then
    printf 'qemu'
  else
    printf 'none'
  fi
}

# Can this (aarch64) container execute x86_64 binaries? That is what makes
# `nix develop --system x86_64-linux` usable — IOG's caches publish x86_64-linux
# only — and it depends on the Docker VM having a binfmt handler (Rosetta).
# The probe is a 132-byte static x86_64 ELF that does exit(42); "exec format
# error" (126) means no handler.
x86_64_runs_here() {
  local probe; probe="$(mktemp)" || return 1
  printf '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00\x01\x00\x00\x00\x78\x00\x40\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x40\x00\x38\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x84\x00\x00\x00\x00\x00\x00\x00\x84\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\xbf\x2a\x00\x00\x00\xb8\x3c\x00\x00\x00\x0f\x05' > "$probe"
  chmod 700 "$probe"
  "$probe" 2>/dev/null
  local rc=$?
  rm -f "$probe"
  [ "$rc" = 42 ]
}

# Memory the container may actually use: the cgroup limit if there is one,
# else everything the (virtual) machine has.
memory_mib() {
  local lim
  lim="$(cat /sys/fs/cgroup/memory.max 2>/dev/null \
         || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null || echo max)"
  if [ "$lim" != max ] && [ "$lim" -lt 1000000000000 ] 2>/dev/null; then
    printf '%d' "$((lim / 1048576))"
  else
    awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo
  fi
}

rosetta_hints() {
  note "  Docker Desktop: Settings > General > 'Use Rosetta for x86_64/amd64 emulation on Apple Silicon'"
  note "  Colima:         colima stop && colima start --vm-type vz --vz-rosetta"
  note "  OrbStack:       on by default (check Settings > System)"
}

doctor_platform() {
  local arch host cpus mem fail=0
  arch="$(uname -m)"
  host="${CBDE_HOST_OS:-?} ${CBDE_HOST_ARCH:-?}"
  cpus="$(nproc 2>/dev/null || echo '?')"
  mem="$(memory_mib)"
  printf '  container: linux/%s    host: %s\n' "$arch" "$host"

  case "$arch" in
    aarch64)
      ok "native aarch64 — GHC, cabal, plustan, aiken, lean and nix run at full speed"
      if x86_64_runs_here; then
        ok "x86_64 binaries run here too (Rosetta) — 'nix develop --system x86_64-linux' can use the IOG caches"
      else
        note "x86_64 binaries cannot run here, so 'nix --system x86_64-linux' (IOG caches) is unavailable;"
        note "everything native still works. To enable it, turn on Rosetta in the Docker runtime and restart it:"
        rosetta_hints
      fi
      ;;
    x86_64)
      case "$(emulator)" in
        none)    ok "native x86_64" ;;
        rosetta) note "x86_64 image under Rosetta on an arm64 host: works, ~2-3x slower than the native arm64 image (unset CBDE_PLATFORM)" ;;
        qemu)
          bad "x86_64 image under QEMU — very slow, and GHC is known to misbehave; use the native image (unset CBDE_PLATFORM) or enable Rosetta:"
          rosetta_hints
          fail=1
          ;;
      esac
      ;;
    *) note "unexpected architecture $arch" ;;
  esac

  printf '  %s CPUs, %s MiB memory available to this container\n' "$cpus" "$mem"
  if [ "$cpus" -lt 4 ] 2>/dev/null; then
    note "fewer than 4 CPUs — cabal builds of plutus projects will crawl"
    [ "${CBDE_HOST_OS:-}" = Darwin ] && note "give the Docker VM more: Docker Desktop > Settings > Resources; Colima: colima start --cpu 8"
  fi
  if [ "$mem" -lt 8000 ] 2>/dev/null; then
    bad "less than 8 GB memory — GHC on plutus-tx dependencies gets OOM-killed below that (16 GB for plutus-tx-plugin modules)"
    [ "${CBDE_HOST_OS:-}" = Darwin ] && note "raise the Docker VM's memory: Docker Desktop > Settings > Resources; Colima: colima start --memory 16"
    fail=1
  fi
  return "$fail"
}

cmd_doctor() {
  local fail=0
  hdr "Platform"
  doctor_platform || fail=1

  hdr "Persistence"
  if nix_is_mounted; then
    ok "volume mounted at /nix"
    [ -f /nix/cbde/.cbde-version ] && printf '    initialized by CBDE %s (image: %s)\n' \
      "$(cat /nix/cbde/.cbde-version)" "${CBDE_IMAGE_VERSION:-?}"
  else
    bad "nothing mounted at /nix — no caches persist, and GHC cannot be installed"
    note "add: -v cbde-data:/nix"
    fail=1
  fi

  hdr "Haskell toolchain"
  if [ -d /root/.cabal ]; then
    # -L: /root/.cabal is a symlink, and plain du would report the link itself.
    ok "cabal state is in the volume ($(du -shL /root/.cabal 2>/dev/null | cut -f1))"
  else
    bad "/root/.cabal does not resolve — cabal is using ~/.local/state/cabal"
    note "that lives in the container, so every run re-downloads and rebuilds."
    note "Usually means a stale volume: check you mounted cbde-data at /nix."
    fail=1
  fi
  local ghc; ghc="$(active_ghc)"
  if [ -n "$ghc" ]; then ok "GHC $ghc"; else bad "no GHC (run: cbde ghc ${CBDE_GHC:-9.6.7})"; fail=1; fi
  if [ -n "$(active_cabal)" ]; then ok "cabal $(active_cabal)"; else bad "no cabal"; fail=1; fi
  if [ -f /nix/cbde/cabal/packages/hackage.haskell.org/01-index.tar ]; then
    ok "hackage index present"
  else
    bad "hackage index missing (run: cbde matrix reset, or: cabal update)"
    fail=1
  fi
  [ -d /nix/cbde/cabal/packages/cardano-haskell-packages ] \
    && ok "CHaP index present" || note "CHaP index missing (cabal update in a project declaring it)"

  hdr "Compatibility matrix"
  local mf
  if [ -z "$(image_matrix)" ]; then
    bad "CBDE_IMAGE_VERSION is not set — this image does not know which matrix it is"
    fail=1
  elif mf="$(matrix_file "$(image_matrix)" 2>/dev/null)"; then
    if matrix_status "$mf" >/dev/null; then
      ok "verified set $(image_matrix): the active toolchain is the one this image was tested with"
    else
      note "custom: the active toolchain differs from matrix $(image_matrix)"
      matrix_status "$mf" | awk -F'\t' '$4 == "off" || $4 == "missing" { printf "      %-6s pinned %-28s active %s\n", $1, $2, $3 }'
      note "fine if deliberate; back to the verified set: cbde matrix reset"
    fi
  else
    bad "this image carries no matrix file for $(image_matrix) (expected $CBDE_MATRIX_DIR/$(image_matrix).env)"
    fail=1
  fi

  hdr "IDE support"
  if [ -n "$(active_hls)" ]; then
    if [ -n "$ghc" ] && [ -x "$GHCUP_BINDIR/haskell-language-server-$ghc" ]; then
      ok "HLS $(active_hls) has a server for GHC $ghc"
    else
      bad "HLS $(active_hls) has no server for GHC $ghc"
      note "servers available: $(ls "$GHCUP_BINDIR" | sed -n 's/^haskell-language-server-\([0-9][^~]*\)$/\1/p' | tr '\n' ' ')"
      fail=1
    fi
  else
    note "HLS not installed (optional; run: cbde hls)"
  fi

  hdr "Workspace and identity"
  printf '  running as uid %s(%s) gid %s\n' \
         "$(id -u)" "$(id -un 2>/dev/null || echo '?')" "$(id -g)"
  if [ -d /workspace ]; then
    local w_uid; w_uid="$(stat -c %u /workspace 2>/dev/null)"
    if [ "$w_uid" = "$(id -u)" ]; then
      ok "/workspace is owned by us — files created here will be yours on the host"
    elif [ "$(id -u)" = 0 ] && [ "$w_uid" = 0 ]; then
      note "/workspace is not a bind mount (or ownership is virtualised)"
    elif [ "$w_uid" = 0 ] && [ -w /workspace ]; then
      # Docker Desktop / Colima: the mount looks like root's to us, but the
      # runtime maps every write back to the host user. The entrypoint put us
      # on the image's cbde uid so the volume and the devcontainer agree.
      ok "/workspace ownership is virtualised by the Docker runtime — new files are yours on the host"
    else
      bad "/workspace is owned by uid $w_uid but we run as $(id -u) — new files get the wrong owner"
      fail=1
    fi
    [ -w /workspace ] && ok "/workspace is writable" || { bad "/workspace is not writable"; fail=1; }
  fi

  hdr "Dev Container"
  if [ -f .devcontainer/devcontainer.json ]; then
    local have want
    have="$(template_version .devcontainer/devcontainer.json)"
    want="$(template_version "$TEMPLATE")"
    if [ -z "$have" ]; then
      note "this project has a devcontainer.json that CBDE did not write — leaving it alone"
    elif [ "$have" = "$want" ] && cmp -s .devcontainer/devcontainer.json "$TEMPLATE"; then
      ok "devcontainer.json matches this image (template $have)"
    elif [ "$have" = "$want" ]; then
      note "devcontainer.json is template $have but has local edits — fine if deliberate"
    else
      note "devcontainer.json is from template $have; this image ships $want"
      note "update with: cbde devcontainer   (it will ask before overwriting)"
    fi
  else
    note "no .devcontainer/devcontainer.json here (create one: cbde devcontainer)"
  fi

  hdr "Tools"
  for t in plustan aiken z3 nix; do
    command -v "$t" >/dev/null 2>&1 && ok "$t" || { bad "$t missing"; fail=1; }
  done
  if [ -z "${CBDE_LEAN:-}" ]; then
    note "Lean provisioning disabled (CBDE_LEAN is empty)"
  elif elan toolchain list 2>/dev/null | grep -qF "$CBDE_LEAN"; then
    ok "Lean $CBDE_LEAN"
  else
    bad "Lean toolchain $CBDE_LEAN not installed — 'lean'/'lake' will not work"
    note "run: cbde lean $CBDE_LEAN"
    fail=1
  fi
  if [ -n "${CBDE_PLUSTAN_GHC:-}" ] && [ -n "$ghc" ] && [ "$ghc" != "$CBDE_PLUSTAN_GHC" ]; then
    bad "plustan reads .hie from GHC $CBDE_PLUSTAN_GHC only, but GHC $ghc is active"
    note "run: cbde ghc $CBDE_PLUSTAN_GHC"
    fail=1
  fi

  printf '\n'
  [ "$fail" = 0 ] && ok "no problems found" || note "see the failures above"
  return "$fail"
}

case "${1:-help}" in
  ghc)    cmd_switch ghc "${2:-}" ;;
  cabal)  cmd_switch cabal "${2:-}" ;;
  hls)    cmd_hls "${2:-}" ;;
  lean)   cmd_lean "${2:-}" ;;
  list|ls) cmd_list ;;
  matrix) shift; cmd_matrix "$@" ;;
  update) cmd_update ;;
  devcontainer) cmd_devcontainer "${2:-}" ;;
  doctor) cmd_doctor ;;
  help|-h|--help) usage ;;
  *) printf 'cbde: unknown command %s\n\n' "$1" >&2; usage; exit 2 ;;
esac
