# CBDE compatibility matrix 0.2.0 — the verified set shipped as image cbde:0.2.0.
#
# Keys are Dockerfile ARG names; `cbde build` passes every line as a build-arg
# and the image refuses to build if its ARGs disagree with this file. Inside a
# container, `cbde matrix` compares the active toolchain against these pins.
# Values: letters, digits and ._:/+~@- only. No quotes, no expansion.
CBDE_IMAGE_VERSION=0.2.0

# Provisioned into the /nix volume on first start; switchable at run time.
CBDE_GHC=9.6.7
CBDE_CABAL=3.10.3.0
CBDE_HLS=
CBDE_LEAN=leanprover/lean4:v4.24.0

# Baked into the image; change only by changing image.
GHCUP_VERSION=0.2.6.2
AIKEN_VERSION=v1.1.23
Z3_TAG=z3-4.15.2
PLUSTAN_REF=main
BLASTER_REF=main
LIBSODIUM_REV=dbb48cce5429cb6585c9034f002568964f1ce567
SECP256K1_REV=ac83be33d0956faf6b7f61a60ab524ef7d6a473a
BLST_TAG=v0.3.14
