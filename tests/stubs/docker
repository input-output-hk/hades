#!/usr/bin/env bash
# Fake docker for the launcher tests. Logs every call to $STUB_LOG and answers
# the few queries the launcher makes:
#   STUB_IMAGES         space-separated refs that `image inspect` reports present
#   STUB_IMAGE_VERSION  CBDE_IMAGE_VERSION that `image inspect -f` reports
#   STUB_PULL_FAIL      set to make `docker pull` fail
#   STUB_CONTAINERS     names `container inspect` reports (append :stopped for a stopped one)
#   STUB_TAGS           what `docker images cbde --format` lists
#   STUB_ARCH           what `image inspect --format {{.Architecture}}` reports (default amd64)
#   STUB_REMOTE_ARCH_TAGS  tags (0.2.0-amd64 latest-amd64 ...) that `buildx imagetools
#                       inspect <ref>` finds in the registry; anything else fails, except a
#                       ref an earlier `buildx imagetools create -t <ref>` in this log wrote
printf 'docker %s\n' "$*" >> "${STUB_LOG:?STUB_LOG is not set}"
case "${1:-} ${2:-}" in
  "image inspect")
    for ref; do :; done
    case " $* " in
      *"{{.Architecture}}"*) printf '%s\n' "${STUB_ARCH:-amd64}"; exit 0 ;;
      *" -f "*|*" --format "*)
        # Env of an image: version from STUB_IMAGE_VERSION, else from the ref's
        # tag (latest -> 0.2.0). Pins default to matrix 0.2.0's; a tag's GHC
        # can be overridden with STUB_GHC_<tag with dots as underscores>.
        tag="${ref##*:}"; [ "$tag" = latest ] && tag=0.2.0
        v="${STUB_IMAGE_VERSION:-$tag}"
        eval "ghc=\${STUB_GHC_$(printf '%s' "$tag" | tr . _)-9.6.7}"
        printf 'PATH=/usr/bin\nCBDE_IMAGE_VERSION=%s\nCBDE_GHC=%s\nCBDE_CABAL=3.10.3.0\nCBDE_LEAN=leanprover/lean4:v4.24.0\n' "$v" "$ghc"
        exit 0 ;;
    esac
    case " ${STUB_IMAGES:-} " in *" $ref "*) exit 0 ;; *) exit 1 ;; esac ;;
  "container inspect")
    for ref; do :; done
    case " ${STUB_CONTAINERS:-} " in
      *" $ref "*)   case " $* " in *" -f "*) echo true ;; esac; exit 0 ;;
      *" $ref:stopped "*) case " $* " in *" -f "*) echo false ;; esac; exit 0 ;;
      *) exit 1 ;;
    esac ;;
  "images "*) printf '%s\n' ${STUB_TAGS-0.2.0 latest} ;;
  "exec "*) exit 0 ;;
  "pull "*) [ -z "${STUB_PULL_FAIL:-}" ] || { echo "stub: pull failed" >&2; exit 1; } ;;
  "volume inspect") exit 1 ;;
  "buildx imagetools")
    for ref; do :; done
    case "${3:-}" in
      inspect)
        tag="${ref##*:}"
        case " ${STUB_REMOTE_ARCH_TAGS:-} " in *" $tag "*) exit 0 ;; esac
        # An index this run wrote: its platforms are its sources' arches.
        created="$(grep "^docker buildx imagetools create -t $ref " "$STUB_LOG" | tail -n 1 || true)"
        [ -n "$created" ] || exit 1
        case " $* " in *" --format "*)
          for src in ${created#*-t "$ref" }; do printf 'linux/%s ' "${src##*-}"; done; echo ;;
        esac
        exit 0 ;;
      create) exit 0 ;;
    esac ;;
esac
exit 0
