#!/usr/bin/env bash
# STUB_CABAL: version to report; unset = 3.10.3.0; empty = not installed.
printf 'cabal %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
case "${1:-}" in
  --numeric-version) v="${STUB_CABAL-3.10.3.0}"; [ -n "$v" ] || exit 1; echo "$v" ;;
  update) [ -z "${STUB_CABAL_FAIL:-}" ] || exit 1 ;;
esac
exit 0
