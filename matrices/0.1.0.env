# CBDE compatibility matrix 0.1.0 — identical to 0.2.0 except GHC 9.6.6, the
# version sc-testing-tools pins. Exists to exercise switching between matrices
# on one shared volume; ships as cbde:0.1.0 and never becomes cbde:latest.
# Values: letters, digits and ._:/+~@- only. No quotes, no expansion.
CBDE_IMAGE_VERSION=0.1.0

# Provisioned into the /nix volume on first start; switchable at run time.
CBDE_GHC=9.6.6
CBDE_CABAL=3.10.3.0
CBDE_HLS=
CBDE_LEAN=leanprover/lean4:v4.24.0

# The Hackage and CHaP snapshots this matrix was verified against. The image
# carries both indices at exactly these states and seeds them into the volume;
# moving either is a new matrix.
CBDE_INDEX_STATE=2026-09-21T04:01:53Z
CBDE_CHAP_INDEX_STATE=2026-09-16T23:53:07Z

# Baked into the image; change only by changing image.
GHCUP_VERSION=0.2.6.2
AIKEN_VERSION=v1.1.23
Z3_TAG=z3-4.15.2
PLUSTAN_REF=main
BLASTER_REF=main
LIBSODIUM_REV=dbb48cce5429cb6585c9034f002568964f1ce567
SECP256K1_REV=ac83be33d0956faf6b7f61a60ab524ef7d6a473a
BLST_TAG=v0.3.14
